{
  "name": "dsh-gov-boot",
  "version": "0.5.0",
  "description": "政务风 DSH 开机动画：宣纸长城片头 → 科技蓝统一身份认证（账号 / 扫码 / CA 三种登录方式）→ 选择工作台；设置里可切换关闭 / 仅片头 / 完整和三套配色。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "preview",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "author": "okiexia-ui (https://github.com/okiexia-ui)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okiexia-ui/dsh-gov-boot.git"
  },
  "homepage": "https://github.com/okiexia-ui/dsh-gov-boot#readme",
  "bugs": {
    "url": "https://github.com/okiexia-ui/dsh-gov-boot/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "boot-animation",
    "splash",
    "login-animation",
    "开机动画",
    "启动动画",
    "登录动画",
    "政务"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/client.js && node --check lib/index.js",
    "test": "npm run check && node --test test/host.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.cjs",
    "test:dsh": "node --test --test-concurrency=1 test/dsh.test.cjs",
    "test:all": "npm test && npm run test:e2e && npm run test:dsh",
    "shots": "node scripts/shots.mjs",
    "demo": "node scripts/demo.mjs",
    "prepack": "npm run build && npm run check"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
